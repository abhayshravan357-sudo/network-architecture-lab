{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PacketDefinition",
  "description": "A packet generated by the simulation engine during a ping run.",
  "type": "object",
  "required": ["id", "type", "source", "target", "path", "timestamp", "payload"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["arp-request", "arp-reply", "icmp-echo", "icmp-reply"]
    },
    "source": { "type": "string", "description": "Originating device id, or 'broadcast' for ARP requests" },
    "target": { "type": "string", "description": "Destination device id, or 'broadcast'" },
    "path": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered device ids the packet traverses"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
